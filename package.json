{
  "name": "tincture",
  "description": "Desktop prompt editor for NovelAI image generation (V4 and later): block-based prompts, direct generation and a local image library",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:test": "node scripts/dev.mjs --test --port 5190",
    "app": "node scripts/dev.mjs --app",
    "server": "node server/main.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:app": "playwright test -c playwright.app.config.ts",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "data:tags": "node scripts/build-tags.mjs",
    "data:chars": "node scripts/build-chars.mjs",
    "data:wiki": "node scripts/build-wiki.mjs",
    "data:tokenizer": "node scripts/build-tokenizer.mjs && node scripts/build-tokenizer-t5.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.81",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-virtual": "^3.14.14",
    "ai": "^7.0.157",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "fastify": "^5.12.7",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "json5": "^2.2.3",
    "motion": "^14.1.0",
    "msgpackr": "^2.1.3",
    "nanoid": "^6.0.2",
    "pinyin-pro": "^3.29.5",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "4.14.6",
    "sonner": "^2.0.8",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.1.0",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "oxlint": "^1.81.0",
    "rollup-plugin-license": "3.7.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
